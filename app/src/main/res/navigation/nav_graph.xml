<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Bottom bar tabs (ids match menu/bottom_nav.xml) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tcg_manager.ui.home.HomeFragment"
        android:label="@string/nav_main"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.tcg_manager.ui.collection.CollectionFragment"
        android:label="@string/collection_label"
        tools:layout="@layout/fragment_collection">

        <action
            android:id="@+id/action_collection_to_cardDetail"
            app:destination="@id/cardDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/decksFragment"
        android:name="com.example.tcg_manager.ui.decks.DecksFragment"
        android:label="@string/nav_decks"
        tools:layout="@layout/fragment_decks" />

    <!-- Opened from the scan button -->
    <fragment
        android:id="@+id/scanFragment"
        android:name="com.example.tcg_manager.ui.scan.ScanFragment"
        android:label="@string/scan_label"
        tools:layout="@layout/fragment_scan">

        <action
            android:id="@+id/action_scan_to_cardDetail"
            app:destination="@id/cardDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cardDetailFragment"
        android:name="com.example.tcg_manager.ui.card.CardDetailFragment"
        android:label="@string/detail_label"
        tools:layout="@layout/fragment_card_detail" />
</navigation>
